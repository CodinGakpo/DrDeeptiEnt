# Copy this file to .env and fill in real values for local development.
# In production (Lambda), these are set as environment variables via SAM parameters.

# Meta / WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_temporary_or_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
WHATSAPP_VERIFY_TOKEN=choose_a_random_secret_string

# Staff notification
STAFF_WHATSAPP_NUMBER=+91XXXXXXXXXX

# Database
# For local dev: use the Direct Connection string from Neon dashboard
# For Lambda:    use the POOLED Connection string from Neon dashboard
#                (hostname ends in -pooler, e.g. ep-xxx-pooler.region.aws.neon.tech)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/dbname?ssl=require

# Legacy individual PG vars (used if DATABASE_URL is not set)
PGHOST=ep-xxx.region.aws.neon.tech
PGDATABASE=your_db_name
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGPORT=5432
